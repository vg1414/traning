rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isDavid() {
      return request.auth != null && request.auth.token.email == 'david@traning.app';
    }

    // Davids pass och övningslistan – bara inloggad David
    match /users/david/{doc=**} {
      allow read, write: if isDavid();
    }
    match /global/{doc=**} {
      allow read, write: if isDavid();
    }

    // Emmas, Demos och övrig gammal data lämnas öppen som tidigare
    match /users/{uid}/{doc=**} {
      allow read, write: if uid != 'david';
    }
    match /{coll}/{doc=**} {
      allow read, write: if coll != 'users' && coll != 'global';
    }
  }
}
